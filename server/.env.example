PORT=3000
JWT_SECRET=change-this-secret-in-production
ADMIN_DEFAULT_PASSWORD=11223344
DB_PATH=./data/loot-ledger.db

# Subpath bajo el que cuelga toda la app (API + estáticos) cuando convive con
# otro sitio en el mismo dominio, ej. "/loot-ledger" para
# www.castielo.io/loot-ledger (ver docs/deploy-ssd-domain.md). Vacío por
# defecto: la app vive en la raíz del dominio, como siempre. Tiene que
# coincidir con el BASE_PATH usado al buildear el cliente
# ("BASE_PATH=/loot-ledger npm run build" dentro de client/).
# BASE_PATH=/loot-ledger

# Origin permitido para las dos rutas públicas de invitación
# (GET /api/auth/invite/:code y POST /api/auth/claim-invite), para que un
# sitio externo (ej. una card de portfolio) las pueda llamar desde el
# navegador. Default: https://castielo.duckdns.org
# INVITE_CORS_ORIGIN=https://castielo.duckdns.org

# --- Acceso remoto (opcionales, ver docs/deploy-ssd-domain.md) ---

# Opción A: Cloudflare Tunnel (perfil "tunnel"). Token del túnel creado en
# el dashboard de Cloudflare (Zero Trust > Networks > Tunnels).
# CLOUDFLARE_TUNNEL_TOKEN=

# Opción B: DuckDNS + Caddy (perfil "duckdns"), para probar gratis sin
# comprar un dominio. Subdominio y token de https://www.duckdns.org
# DUCKDNS_SUBDOMAIN=loot-ledger
# DUCKDNS_TOKEN=
# Dominio público que usa Caddy para pedir el certificado HTTPS: cambiar a
# "www.loot-ledger.io" el día que se compre el dominio propio.
# PUBLIC_DOMAIN=loot-ledger.duckdns.org
